class Solution {
    public boolean isPalindrome(String s) {
        String a=s.toLowerCase();
        StringBuilder t = new StringBuilder(); 
        boolean flag = true;
        for(int i=0;i<a.length();i++){
            char ch = a.charAt(i);
            if(ch>=97 && ch<=122 || ch >=48 && ch<=57){
               t.append(ch);
            }
        }

        int i=0;
        int j=t.length()-1;
        while(i<j){
            if(t.charAt(i)!=t.charAt(j)){
                flag=false;
            }
            i++;
            j--;
        }
        return flag;
    }
}
