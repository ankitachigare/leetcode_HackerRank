class Solution {
    public int searchInsert(int[] nums, int target) {
        int pos=nums.length;
        if(target<nums[0]){
            pos=0;
        }
        for(int i=0;i<nums.length;i++){
            if(nums[i]==target){
                pos = i;
            }
            if(i+1<nums.length){
                if(nums[i]<target && nums[i+1]>target){
                    pos = i+1;
                }
            }
        }
        return pos;
    }
}
