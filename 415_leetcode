class Solution {
    public String addStrings(String num1, String num2) {
        // int a=Integer.parseInt(num1);
        // int b=Integer.parseInt(num2);
        int i,a=0,b=0;
        for(i=0;i<num1.length();i++){
           a=(a*10)+getDigitValue(num1.charAt(i));
        }
        for(i=0;i<num2.length();i++){
           b=(b*10)+getDigitValue(num2.charAt(i));
        }
        int ans=a+b;
        String ans1=String.valueOf(ans);
        return ans1;
    }
    private static int getDigitValue(char c) {
    switch (c) {
        case '1': return 1;
        case '2': return 2;
        case '3': return 3;
        case '4': return 4;
        case '5': return 5;
        case '6': return 6;
        case '7': return 7;
        case '8': return 8;
        case '9': return 9;
        case '0': return 0;
        default: throw new IllegalArgumentException("Invalid numeric character: " + c);
    }
    }
}
