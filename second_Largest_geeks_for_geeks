class Solution {
    public int getSecondLargest(int[] arr) {
        // code here
        int largest =arr[0];
        int seclargest=-1;
        for(int i=0;i<arr.length;i++){
            if(arr[i]>largest){
                largest=arr[i];
            }
        }
        for(int j=0;j<arr.length;j++){
            if(arr[j]<largest && arr[j]>seclargest){
                seclargest=arr[j];
            }
        }
        
        return seclargest;
    }
}
